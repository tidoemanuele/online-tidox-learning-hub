---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { resolveInsightLink } from '../lib/hub-episode-utils';

const episodes = await getCollection('episodes');
const sorted = episodes.sort((a, b) => b.data.date.localeCompare(a.data.date));
const latest = sorted[0];
const ep = latest.data;

// Resolve audio — same logic as [date].astro
const audioDir = join(process.cwd(), 'public', 'audio', ep.date);
const localBriefNames = [
  'brief.mp3', 'brief.m4a', 'brief.wav',
  'narration.mp3', 'narration.m4a', 'narration.wav',
];
let localBriefUrl: string | undefined;
for (const name of localBriefNames) {
  if (existsSync(join(audioDir, name))) {
    localBriefUrl = `/audio/${ep.date}/${name}`;
    break;
  }
}
const resolvedAudio =
  ep.audio?.briefAudioUrl?.trim() || localBriefUrl || ep.audio?.podcastUrl?.trim() || undefined;

// Check for pre-rendered video
const mp4Path = join(process.cwd(), 'public', 'video', `${ep.date}.mp4`);
const hasVideo = existsSync(mp4Path);

// Top 3 insights for the preview
const topInsights = ep.insights.slice(0, 3);
const editionDate = ep.date.replace(/-/g, '.');
---

<Base title="Today" description={ep.subtitle}>
  <!-- Edition line -->
  <p class="edition">
    <span class="edition-no">№&nbsp;{ep.episodeNumber}</span>
    <span class="edition-sep" aria-hidden="true">/</span>
    <time datetime={ep.date}>{editionDate}</time>
    <span class="edition-sep" aria-hidden="true">/</span>
    <span>Daily Brief</span>
  </p>

  <!-- Topic kicker -->
  <p class="kicker">{ep.title}</p>

  <!-- Stat-Led hero: the figure is the spine, its meaning the headline -->
  {ep.heroStat ? (
    <section class="stat-hero" aria-label="Lead figure">
      <div class="stat-figure">{ep.heroStat.value}</div>
      <h1 class="stat-qualifier">{ep.heroStat.label}</h1>
      <p class="dek">{ep.subtitle}</p>
    </section>
  ) : (
    <section class="stat-hero" aria-label="Lead">
      <h1 class="stat-qualifier stat-qualifier--lead">{ep.subtitle}</h1>
    </section>
  )}

  <!-- Video / Audio player -->
  {hasVideo ? (
    <div class="media">
      <video
        class="w-full aspect-video"
        style="background: var(--color-void);"
        controls
        playsinline
        preload="metadata"
        aria-label="Daily intelligence brief"
      >
        <source src={`/video/${ep.date}.mp4`} type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>
  ) : resolvedAudio ? (
    <div class="audio-card" aria-label="Today's brief audio">
      <div class="audio-head">
        <span class="audio-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21" /></svg>
        </span>
        <div>
          <p class="audio-title">Today's brief</p>
          <p class="audio-sub">Listen to the daily intelligence brief</p>
        </div>
      </div>
      <audio controls preload="metadata" class="w-full" src={resolvedAudio}>
        Your browser does not support audio playback.
      </audio>
    </div>
  ) : null}

  <!-- Top insights — numbered brief -->
  <section class="brief">
    <div class="brief-head">
      <h2>Top Insights</h2>
      <span class="brief-count">{ep.insights.length} in today's edition</span>
    </div>
    <ol class="brief-list">
      {topInsights.map((insight, i) => {
        const link = resolveInsightLink(insight);
        return (
          <li class="brief-item">
            <span class="brief-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="brief-body">
              {link?.isDirect ? (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="brief-text-link">
                  <p class="brief-text">{insight.text}</p>
                </a>
              ) : (
                <p class="brief-text">{insight.text}</p>
              )}
              {link && !link.isDirect && (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="brief-source">
                  {link.label} ↗
                </a>
              )}
              {insight.tags.length > 0 && (
                <div class="brief-tags">
                  {insight.tags.map((tag) => (<span class="tag">{tag}</span>))}
                </div>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <!-- CTAs — outlined chips -->
  <div class="cta-row">
    <a href={`/daily/${ep.date}`} class="cta cta--solid">Read full episode →</a>
    <a href="/archive" class="cta cta--outline">Browse archive ({sorted.length} episodes)</a>
  </div>
</Base>

<style>
  /* ── Edition + kicker ── */
  .edition {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gray);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
  }
  .edition-no { color: var(--color-near-black); }
  .edition-sep { color: var(--color-rule-strong); }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    margin: 0 0 0.75rem;
  }

  /* ── Stat-Led hero ── */
  .stat-hero {
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 2.25rem;
    margin-bottom: 2.25rem;
  }
  .stat-figure {
    font-family: var(--font-mono);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    font-size: clamp(3.25rem, 11vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: var(--color-cream);
    overflow-wrap: anywhere;
    min-width: 0;
    margin-bottom: 1rem;
  }
  .stat-qualifier {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(1.35rem, 3.4vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-heading);
    overflow-wrap: anywhere;
    min-width: 0;
    margin: 0;
  }
  .stat-qualifier--lead { font-size: clamp(1.6rem, 4.5vw, 2.35rem); }
  .dek {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-near-black);
    max-width: 62ch;
    margin: 1rem 0 0;
  }

  /* ── Media ── */
  .media { border-radius: var(--radius-card); overflow: hidden; margin-bottom: 2.25rem; }
  .media video { display: block; width: 100%; }
  .audio-card {
    background: var(--color-light-bg);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    padding: 1.1rem;
    margin-bottom: 2.25rem;
  }
  .audio-head { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.85rem; }
  .audio-badge {
    width: 2.25rem; height: 2.25rem; flex: none;
    background: var(--color-terracotta); color: var(--color-cream);
    border-radius: 999px; display: flex; align-items: center; justify-content: center;
  }
  .audio-badge svg { width: 0.95rem; height: 0.95rem; margin-left: 0.1rem; }
  .audio-title { font-size: 0.8125rem; font-weight: 600; color: var(--color-heading); margin: 0; }
  .audio-sub { font-size: 0.6875rem; color: var(--color-gray); margin: 0.1rem 0 0; }

  /* ── Numbered brief ── */
  .brief { margin-bottom: 2.5rem; }
  .brief-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
    border-bottom: 2px solid var(--color-terracotta);
    padding-bottom: 0.6rem; margin-bottom: 0.5rem;
  }
  .brief-head h2 {
    font-family: var(--font-mono);
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-terracotta); margin: 0;
  }
  .brief-count { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-gray); }
  .brief-list { list-style: none; margin: 0; padding: 0; }
  .brief-item {
    display: flex; gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .brief-item:last-child { border-bottom: 0; }
  .brief-num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem; font-weight: 700;
    color: var(--color-terracotta);
    padding-top: 0.15rem; flex: none;
  }
  .brief-body { min-width: 0; }
  .brief-text { font-size: 0.95rem; line-height: 1.65; color: var(--color-near-black); margin: 0; }
  .brief-text-link { text-decoration: none; display: block; border-radius: 3px; }
  .brief-text-link:hover .brief-text { color: var(--color-terracotta); }
  .brief-text-link:focus-visible { outline: 2px solid var(--color-terracotta); outline-offset: 3px; }
  .brief-source {
    display: inline-block; margin-top: 0.55rem;
    font-size: 0.75rem; font-weight: 600; color: var(--color-terracotta); text-decoration: none;
  }
  .brief-source:hover { text-decoration: underline; }
  .brief-source:focus-visible { outline: 2px solid var(--color-terracotta); outline-offset: 2px; border-radius: 2px; }
  .brief-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.7rem; }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.625rem; letter-spacing: 0.04em;
    padding: 0.15rem 0.45rem; border-radius: 3px;
    background: var(--color-light-bg); color: var(--color-gray);
  }

  /* ── CTAs ── */
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .cta {
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 0.875rem; font-weight: 600;
    padding: 0.7rem 1.25rem; border-radius: 0.6rem;
    text-decoration: none; transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .cta--solid { background: var(--color-terracotta); color: var(--color-cream); }
  .cta--solid:hover { background: var(--color-terracotta-deep); }
  .cta--outline { border: 1px solid var(--color-rule-strong); color: var(--color-gray); }
  .cta--outline:hover { color: var(--color-heading); border-color: var(--color-gray); }
  .cta:focus-visible { outline: 2px solid var(--color-terracotta); outline-offset: 3px; }

  @media (max-width: 40rem) {
    .cta { flex: 1 1 100%; }
  }
</style>
