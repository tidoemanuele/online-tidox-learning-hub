---
import Base from '../layouts/Base.astro';
import { EpisodeSearch } from '../components/EpisodeSearch';
import { getCollection } from 'astro:content';

const episodes = await getCollection('episodes');
const dates = episodes.map((ep) => ep.data.date).sort();
const oldest = dates[0];
const newest = dates[dates.length - 1];
---

<Base
  title="Search"
  description="Search every Tidox Hub daily brief — insights, headlines and repos from the whole archive."
>
  <h1 class="page-title">Search</h1>
  <p class="page-dek">
    Every edition from {oldest?.replace(/-/g, '.')} to {newest?.replace(/-/g, '.')}. Partial words
    and small typos still match.
  </p>

  <!-- client:load, not client:visible — the search box is this page's whole purpose -->
  <EpisodeSearch client:load />
</Base>

<style>
  .page-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.15;
    color: var(--color-heading);
    margin: 0 0 0.5rem;
  }
  .page-dek {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-gray);
    max-width: 58ch;
    margin: 0 0 1.75rem;
  }
</style>
